setup bg option image-fps=10/1
setup bg output #transcode{sfilter=mosaic{width=1920,height=1080,cols=3,rows=2,position=1,order="1,2,3,4,5,6",keep-aspect-ratio=enabled,keep-picture=1,mosaic-align=0},vcodec=mp4v}:bridge-in:http{mux=ts,dst=:8090/hyhipcam}


